# ------------------------------------------------------------------
# Tour Egypte — LiteSpeed / cPanel .htaccess
# ------------------------------------------------------------------

RewriteEngine On

# Force HTTPS and canonicalize www -> non-www in a single 301 redirect
# (covers both: HTTP -> HTTPS, and www.touregypte.fr -> touregypte.fr)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.touregypte\.fr$ [NC]
RewriteRule ^(.*)$ https://touregypte.fr/$1 [L,R=301]

# ------------------------------------------------------------------
# Security headers
# ------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------------
# Custom 404 error page
# ------------------------------------------------------------------
ErrorDocument 404 /404.html
